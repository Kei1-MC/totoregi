# ============================================================
# ととレジ .gitignore
# ============================================================

# --- 機密情報（絶対にコミットしない）---
fm_config_secret.php
.env
*.env

# --- デバッグ・開発用（本番コードではない）---
debug_fm_layout.php
sales_entry_debug.php
sales_list_debug.php
sales_entry_1.php
product_debug.php
star_debug_log.php

# --- サーバーサイド生成ファイル ---
sales_queue_data/
*.log

# --- アップロード不要ドキュメント ---
# macOS の NFD / NFC 両方にマッチするようワイルドカード指定
サー*資料/

# --- OS / エディタ ---
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# --- PHP ---
vendor/
composer.lock

# --- FileMaker（CSVインポート時に自動生成される変換ファイル）---
*.fmp12

